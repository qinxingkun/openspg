# Copy to .env and adjust for your environment (optional; compose has defaults).
#
# cp .env.example .env

# Docker image tag for the Nebula-enabled OpenSPG server (built locally).
OPENSPG_SERVER_NEBULA_IMAGE=openspg-server-nebula:local

# Official base image used when running scripts/build-openspg-server-nebula.sh
# OPENSPG_BASE_IMAGE=spg-registry.cn-hangzhou.cr.aliyuncs.com/spg/openspg-server:latest

# trsgraph (NebulaGraph) credentials for graph-store URL
TRSGRAPH_USER=root
TRSGRAPH_PASSWORD=change-me
